<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_page" model="ir.ui.view">
        <field name="name">res.partner.page.configuration</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="birthday_reminder_config" string="Recordatorio de cumpleaños">
                    <group>
                        <group string="Correo al contacto">
                            <field name="send_congrats_email" widget="boolean_toggle"/>
                            <field name="birthday_congrats_last_date"/>
                        </group>
                        <group string="Notificación interna">
                            <field name="take_contact_into_account" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        El correo se envía el día del cumpleaños a las 9:00
                        (hora Ciudad de México), si el contacto tiene email y
                        "Enviar correo de felicitaciones" está activo.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.birthday.reminder</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website'][@widget='url']" position="before">
                <field name="birthday"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_search_birthday_reminder" model="ir.ui.view">
        <field name="name">res.partner.search.birthday.reminder</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="birthday"/>
            </field>
            <filter name="inactive" position="after">
                <separator/>
                <filter
                    string="Fecha de cumpleaños"
                    name="birthday"
                    date="birthday"/>
                <filter
                    string="Recordatorio de notificaciones activo"
                    name="take_contact_into_account"
                    domain="[('take_contact_into_account', '=', True)]"/>
                <filter
                    string="Envío de correos activo"
                    name="send_congrats_email"
                    domain="[('send_congrats_email', '=', True)]"/>
            </filter>
            <filter name="salesperson" position="after">
                <filter
                    string="Fecha de cumpleaños"
                    name="group_birthday"
                    context="{'group_by': 'birthday'}"/>
            </filter>
        </field>
    </record>
</odoo>
