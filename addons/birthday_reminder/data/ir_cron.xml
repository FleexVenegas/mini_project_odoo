<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Notificaciones internas: 10:00 America/Mexico_City (= 16:00 UTC) -->
    <record id="ir_cron_enviar_notificaciones" model="ir.cron">
        <field name="name">Cumpleaños: notificar a usuarios Odoo</field>
        <field name="model_id" ref="model_birthday_reminder_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_enviar_notificaciones()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=16, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Correo al cliente: 09:00 America/Mexico_City (= 15:00 UTC) -->
    <record id="ir_cron_enviar_felicitaciones" model="ir.cron">
        <field name="name">Cumpleaños: enviar correo al cliente</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_enviar_felicitaciones()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=15, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
