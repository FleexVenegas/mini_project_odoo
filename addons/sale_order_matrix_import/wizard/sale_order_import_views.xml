<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_sale_order_import_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.import.wizard.form</field>
        <field name="model">sale.order.import</field>
        <field name="arch" type="xml">

            <form string="Importación de Pedidos de Venta" version="7.0">

                <div class="alert alert-info" role="alert">
                    Selecciona un archivo Excel para crear múltiples pedidos de venta.
                    Cada fila del archivo corresponde a un pedido.
                </div>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="confirm_orders"/>
                </group>

                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary" />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>

            </form>

        </field>
    </record>


    <record id="action_sale_order_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Sale Orders</field>
        <field name="res_model">sale.order.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('sale_order_matrix_import.group_sale_order_matrix_import'))]"/>
    </record>

    <menuitem id="menu_sale_order_import" name="Importación Múltiple" parent="sale.sale_order_menu" action="action_sale_order_import_wizard" sequence="100" groups="sale_order_matrix_import.group_sale_order_matrix_import" />

</odoo>